# ==============================================================================
# QvaFlow Frontend - Variables de Entorno de Configuración
# ==============================================================================

# Modo de datos:
# - 'true': Usa MockAuthService y datos locales en memoria (desarrollo independiente, sin backend).
# - 'false': Realiza llamadas HTTP reales al backend Symfony a través de httpClient.
VITE_USE_MOCKS=true

# Ruta base de la API REST de Symfony (servida en la misma red local):
VITE_API_BASE_URL=/api

# Modo de enrutamiento del Vue Router:
# - 'hash': Modo hash (#/login, #/). Recomendado para despliegue en XAMPP/Apache sin mod_rewrite.
# - 'history': Modo HTML5 History API (/login). Requiere reglas de reescritura en .htaccess o nginx.
VITE_ROUTER_MODE=hash

# URL del backend Symfony en desarrollo para el proxy reverso de Vite (evita errores CORS):
VITE_BACKEND_PROXY_URL=http://127.0.0.1:8000
